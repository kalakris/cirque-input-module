# Cirque Pinnacle 1CA027 touch controller based device configuration options
#
# Vendored from upstream Zephyr's drivers/input/Kconfig.pinnacle, adapted to
# work as an out-of-tree module on Zephyr 3.5 (ZMK): the `select ... if
# $(dt_compat_on_bus,...)` form upstream uses cannot see this module's
# out-of-tree bindings, so express the bus dependency with `depends on`
# instead, and depend on INPUT explicitly since this Kconfig is not sourced
# from inside Zephyr's `if INPUT` block.
#
# Copyright (c) 2024 Ilia Kharin
# SPDX-License-Identifier: Apache-2.0

config INPUT_PINNACLE
    bool "Cirque Pinnacle 1CA027 Touch Controller Based Device"
    default y
    depends on INPUT
    depends on GPIO
    depends on SPI || I2C
    depends on DT_HAS_CIRQUE_PINNACLE_ENABLED
    help
      Enable driver for Cirque Pinnacle 1CA027 tracked input device.
